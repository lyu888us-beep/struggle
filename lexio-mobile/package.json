{
  "name": "lexio-mobile",
  "version": "1.0.0",
  "description": "Lexio 乐词 · 英语单词记忆 —— Android 单机版（Capacitor）",
  "private": true,
  "scripts": {
    "sync": "cap sync android",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "prepare:assets": "rm -rf www && cp -r ../lexio-desktop/assets www",
    "dev": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
